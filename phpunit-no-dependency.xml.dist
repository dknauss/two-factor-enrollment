<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap-no-dependency.php"
	backupGlobals="false"
	colors="true"
	cacheResultFile="./tests/.phpunit-no-dependency.result.cache"
	>
	<testsuites>
		<testsuite name="No Dependency Tests">
			<directory suffix=".php">tests/no-dependency</directory>
		</testsuite>
	</testsuites>
</phpunit>
