<?xml version="1.0"?>
<ruleset name="Two Factor Enrollment">
	<description>Coding standards for the Two Factor Enrollment plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra"/>

	<!--
	These six WordPressVIPMinimum.JS.* sniffs cannot fire against this codebase:
	`extensions="php"` above means PHPCS only ever opens .php files, so the JS
	tokenizer these sniffs depend on never runs. This plugin ships one small
	inline script and one inline stylesheet for its onboarding screen (via
	wp_add_inline_script()/wp_add_inline_style(), both PHP string literals
	with no interpolated data, delivered from a single conditional hook —
	see Two_Factor_Enrollment_Onboarding::login_enqueue_scripts()) rather
	than separate .js/.css asset files, so there is still no .js file for
	these sniffs to open and no build step. VIPCS still emits a "listening
	for JS" deprecation notice for each one at ruleset load time regardless,
	which is noise, not a finding. If this plugin ever ships a standalone
	.js or .css asset file, remove this exclusion and let these sniffs run
	for real.

	The trade this accepts: embedding the script as a PHP string literal
	means no linter — these excluded sniffs or any other JS tool — ever
	parses it as JavaScript. Correctness there rests on code review and the
	PHPUnit coverage in tests/test-enrollment-onboarding.php, not static
	analysis.
	-->
	<rule ref="WordPress-VIP-Go">
		<exclude name="WordPressVIPMinimum.JS.Window"/>
		<exclude name="WordPressVIPMinimum.JS.DangerouslySetInnerHTML"/>
		<exclude name="WordPressVIPMinimum.JS.InnerHTML"/>
		<exclude name="WordPressVIPMinimum.JS.StrippingTags"/>
		<exclude name="WordPressVIPMinimum.JS.StringConcat"/>
		<exclude name="WordPressVIPMinimum.JS.HTMLExecutingFunctions"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="two-factor-enrollment"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="two_factor_enrollment"/>
				<element value="Two_Factor_Enrollment"/>
				<element value="TWO_FACTOR_ENROLLMENT"/>
			</property>
		</properties>
		<!-- $_tests_dir mirrors the WP core PHPUnit bootstrap convention (see WordPress/two-factor tests/bootstrap.php); it is not a plugin global. -->
		<exclude-pattern>tests/bootstrap.php</exclude-pattern>
		<exclude-pattern>tests/bootstrap-no-dependency.php</exclude-pattern>
	</rule>

	<config name="testVersion" value="7.2-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
